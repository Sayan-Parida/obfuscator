<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.obfuscator</groupId>
    <artifactId>obfuscator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>obfuscator</name>
    <description>Function-preserving JVM bytecode obfuscation: core engine, web API and CLI</description>

    <modules>
        <module>obfuscator-core</module>
        <module>obfuscator-web</module>
        <module>obfuscator-cli</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Not managed by spring-boot-dependencies, so it is pinned here.
             Use org.ow2.asm, never Spring's repackaged org.springframework.asm. -->
        <asm.version>9.10.1</asm.version>
        <!-- Not managed by spring-boot-dependencies: the CLI parser. -->
        <picocli.version>4.7.7</picocli.version>
    </properties>
</project>
